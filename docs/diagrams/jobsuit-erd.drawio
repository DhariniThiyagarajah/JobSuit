        <mxCell id="ent_interview" value="&lt;table style=&apos;width:100%;border-collapse:collapse;font-size:10.5px;font-family:Segoe UI,sans-serif;&apos;&gt;&lt;tr style=&apos;background:#B45309;color:#FFFFFF;font-weight:bold;text-align:center;&apos;&gt;&lt;td colspan=&apos;3&apos; style=&apos;padding:5px 8px;font-size:12px;&apos;&gt;Interview&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;span style=&apos;color:#B45309;font-weight:bold;&apos;&gt;PK&lt;/span&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;&lt;b&gt;interview_id&lt;/b&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;BIGINT&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;span style=&apos;color:#2563EB;font-weight:bold;&apos;&gt;FK&lt;/span&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;application_id&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;BIGINT&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;interview_date&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;TIMESTAMPTZ&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;interview_type&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;VARCHAR(50)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;interview_status&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;VARCHAR(30)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&apos;border-bottom:1px solid #F1F5F9;&apos;&gt;&lt;td style=&apos;width:38px;padding:3px 6px;text-align:center;&apos;&gt;&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;&apos;&gt;notes&lt;/td&gt;&lt;td style=&apos;padding:3px 6px;text-align:right;&apos;&gt;&lt;span style=&apos;color:#64748B;&apos;&gt;TEXT&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.8;verticalAlign=top;align=left;spacing=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1765" y="150" width="230" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="panel_rules" value="&amp;lt;b style=&amp;quot;font-size:12px;color:#1E3A8A;&amp;quot;&amp;gt;PostgreSQL Design &amp;amp; Architectural Rules&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Normalization:&amp;lt;/b&amp;gt; 3NF compliant relational design avoiding update/delete anomalies.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Primary Keys:&amp;lt;/b&amp;gt; Synthetic BIGINT surrogate keys generated via standard identity.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Password Security:&amp;lt;/b&amp;gt; Only cryptographic hashes stored (&amp;lt;code&amp;gt;password_hash&amp;lt;/code&amp;gt;); never plain text.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;M:N Resolution:&amp;lt;/b&amp;gt; Handled cleanly via &amp;lt;code&amp;gt;ProfileSkill&amp;lt;/code&amp;gt; and &amp;lt;code&amp;gt;RequirementSkill&amp;lt;/code&amp;gt; junction tables.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Profile Isolation:&amp;lt;/b&amp;gt; 1:1 relationship between User and UserProfile with UNIQUE constraint.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Nullable Foreign Keys:&amp;lt;/b&amp;gt; &amp;lt;code&amp;gt;CVRecommendation.requirement_id&amp;lt;/code&amp;gt; and &amp;lt;code&amp;gt;CVVersion.job_id&amp;lt;/code&amp;gt; support general profile context." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=10;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1480" y="540" width="540" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="panel_legend" value="&amp;lt;b style=&amp;quot;font-size:12px;color:#1E3A8A;&amp;quot;&amp;gt;Crow&amp;#39;s Foot Notation Legend&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;lt;table style=&amp;#39;font-size:10px;line-height:1.6;&amp;#39;&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;width:55px;&amp;#39;&amp;gt;&amp;amp;mdash;||&amp;amp;mdash;&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;Exactly One (Mandatory 1)&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;&amp;#39;&amp;gt;&amp;amp;mdash;o|&amp;amp;mdash;&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;Zero or One (Optional 1)&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;&amp;#39;&amp;gt;&amp;amp;mdash;|&amp;amp;lt;&amp;amp;mdash;&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;One or Many (Mandatory Many)&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;&amp;#39;&amp;gt;&amp;amp;mdash;o&amp;amp;lt;&amp;amp;mdash;&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;Zero or Many (Optional Many)&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;color:#B45309;&amp;#39;&amp;gt;PK&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;Primary Key Attribute&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;tr&amp;gt;&amp;lt;td style=&amp;#39;font-weight:bold;color:#2563EB;&amp;#39;&amp;gt;FK&amp;lt;/td&amp;gt;&amp;lt;td&amp;gt;Foreign Key Attribute&amp;lt;/td&amp;gt;&amp;lt;/tr&amp;gt;&amp;lt;/table&amp;gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=10;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="2040" y="540" width="410" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="panel_meta" value="&amp;lt;b style=&amp;quot;font-size:12px;color:#1E3A8A;&amp;quot;&amp;gt;JobSuit Compatibility &amp;amp;amp; Recommendation Domain Logic (SRS §4–§5)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Weighted Score Formula:&amp;lt;/b&amp;gt; &amp;lt;code&amp;gt;Score = 0.40*K + 0.20*E + 0.20*W + 0.20*P&amp;lt;/code&amp;gt; (Skills 40%, Education 20%, Work Experience 20%, Projects 20%).&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Match Classification:&amp;lt;/b&amp;gt; Each job requirement is evaluated into one of 4 evidence categories: &amp;lt;i&amp;gt;Matched, Partially Matched, Not Evidenced, Needs Verification&amp;lt;/i&amp;gt;.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Truthful CV Advice:&amp;lt;/b&amp;gt; Missing CV items never imply lack of ability; system never invents credentials and recommends verified gaps.&amp;lt;br&amp;gt;&amp;amp;bull; &amp;lt;b&amp;gt;Pipeline Tracking:&amp;lt;/b&amp;gt; Applications support statuses (&amp;lt;i&amp;gt;Applied, Under Review, Shortlisted, Interview, Selected, Rejected&amp;lt;/i&amp;gt;) and track multi-round interviews." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=10;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1480" y="760" width="970" height="220" as="geometry"/>
        </mxCell>
