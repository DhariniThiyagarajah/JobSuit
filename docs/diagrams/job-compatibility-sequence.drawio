        <!-- ================= BOTTOM CALLOUT BOXES ================= -->
        <mxCell id="callout_legend" value="&lt;b style=&quot;font-size:12px;color:#0F172A;&quot;&gt;UML Sequence Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E40AF&quot;&gt;&amp;bull; &lt;b&gt;Solid Arrow:&lt;/b&gt; Synchronous Request / Invocation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#0F766E&quot;&gt;&amp;bull; &lt;b&gt;Dashed Arrow:&lt;/b&gt; Reply / Return Message&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;&amp;bull; &lt;b&gt;Reflexive Arrow:&lt;/b&gt; Self-Call / Internal Logic Execution&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#991B1B&quot;&gt;&amp;bull; &lt;b&gt;alt Frame:&lt;/b&gt; Conditional Alternative Branch (UML 2.5)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&amp;bull; &lt;b&gt;Green Path:&lt;/b&gt; Successful Processing &amp;amp; Persistence Flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;&amp;bull; &lt;b&gt;Red/Amber Path:&lt;/b&gt; Error / Missing Data Early Exit Flow&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=10;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1435" width="460" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="callout_rules" value="&lt;b style=&quot;font-size:12px;color:#78350F;&quot;&gt;Important Business Rules (SRS §5.3 &amp;amp; §7)&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Authentication &amp;amp; Privacy:&lt;/b&gt; Only authenticated users can request analysis; users access only their own records (BR-002, NFR-003).&lt;br&gt;&amp;bull; &lt;b&gt;Confirmed Data Only:&lt;/b&gt; Only user-confirmed profile details and job requirements are utilised in analysis (BR-005, BR-013).&lt;br&gt;&amp;bull; &lt;b&gt;No Negative Inference:&lt;/b&gt; Missing CV evidence must not automatically imply a lack of ability (BR-007).&lt;br&gt;&amp;bull; &lt;b&gt;Truthfulness Guarantee:&lt;/b&gt; System must never invent or fabricate qualifications, skills or experience (BR-008).&lt;br&gt;&amp;bull; &lt;b&gt;Documented Alignment:&lt;/b&gt; The compatibility score represents documented alignment, not a prediction of hiring probability.&lt;br&gt;&amp;bull; &lt;b&gt;Transparent Reasoning:&lt;/b&gt; Ambiguous items are marked &quot;Needs Verification&quot; rather than assumed to be true or false." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=10;fontColor=#78350F;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="1435" width="940" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="callout_scoring" value="&lt;b style=&quot;font-size:12px;color:#0F172A;&quot;&gt;Scoring Model Formula (SRS §5)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;color:#475569;&quot;&gt;Initial Rule-Based Weighted Algorithm&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#1E40AF;&quot;&gt;S = 0.40K + 0.20E + 0.20W + 0.20P&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;K:&lt;/b&gt; Skills (40% weight)&lt;br&gt;&amp;bull; &lt;b&gt;E:&lt;/b&gt; Education (20% weight)&lt;br&gt;&amp;bull; &lt;b&gt;W:&lt;/b&gt; Work Experience (20% weight)&lt;br&gt;&amp;bull; &lt;b&gt;P:&lt;/b&gt; Academic &amp;amp; Proj (20% weight)&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&lt;b&gt;Output Scale: 0–100&lt;/b&gt; | 4 Categorised Tiers&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=10;fontColor=#0F172A;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1435" width="500" height="140" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
