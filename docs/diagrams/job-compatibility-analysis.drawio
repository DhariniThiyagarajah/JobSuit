<mxfile host="Electron" modified="2026-11-25T15:10:00.000Z" agent="JobSuit" version="24.0.0" type="device">
  <diagram id="jobsuit-activity-job-compatibility-analysis" name="Job Compatibility Analysis Workflow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size:16px;color:#0F172A;&quot;&gt;JobSuit – Job Compatibility Analysis Workflow&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#475569;&quot;&gt;UML Activity Diagram with User &amp;amp; System Swimlanes (Profile-to-Job Matching &amp;amp; Explainable Compatibility Report)&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1140" height="50" as="geometry"/>
        </mxCell>

        <!-- Swimlane: User -->
        <mxCell id="lane_user" value="&lt;b style=&quot;font-size:14px;color:#1E3A8A;&quot;&gt;User (Job Seeker)&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;swimlaneFillColor=#FFFFFF;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;rounded=0;fontColor=#1E3A8A;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="540" height="1700" as="geometry"/>
        </mxCell>

        <!-- Swimlane: JobSuit System -->
        <mxCell id="lane_system" value="&lt;b style=&quot;font-size:14px;color:#065F46;&quot;&gt;JobSuit System&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;swimlaneFillColor=#FFFFFF;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=2;rounded=0;fontColor=#065F46;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="600" height="1700" as="geometry"/>
        </mxCell>

        <!-- Scoring Model Callout Box -->
        <mxCell id="callout_scoring" value="&lt;b&gt;Scoring Model Formula&lt;/b&gt;&lt;br&gt;&lt;i&gt;Rule-Based (SRS §5)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;S = 0.4K + 0.2E + 0.2W + 0.2P&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;K:&lt;/b&gt; Skills (40%)&lt;br&gt;&amp;bull; &lt;b&gt;E:&lt;/b&gt; Education (20%)&lt;br&gt;&amp;bull; &lt;b&gt;W:&lt;/b&gt; Experience (20%)&lt;br&gt;&amp;bull; &lt;b&gt;P:&lt;/b&gt; Projects (20%)&lt;br&gt;&lt;font color=&quot;#1E40AF&quot;&gt;&lt;b&gt;Score: 0–100 Scale&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#0F172A;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1030" y="890" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Business Rules Callout Box -->
        <mxCell id="callout_rules" value="&lt;b&gt;Important Business Rules (SRS §5.3)&lt;/b&gt;&lt;br&gt;&amp;bull; Missing info in CV must not automatically imply lack of ability.&lt;br&gt;&amp;bull; System must never fabricate qualifications, skills or experience.&lt;br&gt;&amp;bull; Only confirmed profile and job data are utilised in analysis.&lt;br&gt;&amp;bull; Compatibility score reflects documented alignment, not hiring probability.&lt;br&gt;&amp;bull; Ambiguous items are marked &quot;Needs Verification&quot; rather than assumed." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#78350F;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="625" y="1490" width="345" height="155" as="geometry"/>
        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend_box" value="&lt;b&gt;UML Diagram Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&amp;bull; [Yes] Success Flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;&amp;bull; [No] Missing Data Loop&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;&amp;bull; User Interaction Flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#059669&quot;&gt;&amp;bull; System Processing Flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;&amp;bull; Standard Control Flow&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#713F12&quot;&gt;&amp;bull; &amp;lt;&amp;gt; Decision / Merge Node&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="990" y="1490" width="195" height="155" as="geometry"/>
        </mxCell>

