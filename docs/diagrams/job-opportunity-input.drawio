        <mxCell id="e_dec_content_yes" value="[Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="dec_content_retrieved" target="act_extract_details_b" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Decision Content Retrieved [No] -> Inform Inaccessible -->
        <mxCell id="e_dec_content_no" value="[No]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#DC2626;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="dec_content_retrieved" target="act_inform_inaccessible" parent="1">
          <mxGeometry relative="1" as="geometry"/>
