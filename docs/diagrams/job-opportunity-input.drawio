          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="1590"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Decision Info Correct [Yes] -> Confirm Job -->
        <mxCell id="e_dec_info_yes" value="[Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#15803D;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="dec_info_correct" target="act_confirm_job" parent="1">
          <mxGeometry relative="1" as="geometry"/>
