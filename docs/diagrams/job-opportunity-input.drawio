              <mxPoint x="800" y="1410"/>
              <mxPoint x="800" y="1445"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Merge Branches -> Display Info -->
        <mxCell id="e_merge_display" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" source="merge_branches" target="act_display_info" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Display Info -> Merge Review (Cross swimlanes) -->
        <mxCell id="e_display_mergereview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="act_display_info" target="merge_review" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="1520"/>
              <mxPoint x="540" y="1590"/>
