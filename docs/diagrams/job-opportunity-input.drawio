        <!-- Merge Review -> Review Details -->
        <mxCell id="e_mergereview_review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" source="merge_review" target="act_review_details" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Review Details -> Decision Info Correct -->
        <mxCell id="e_review_decinfo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" source="act_review_details" target="dec_info_correct" parent="1">
          <mxGeometry relative="1" as="geometry"/>
