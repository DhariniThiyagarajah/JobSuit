              <mxPoint x="95" y="1300"/>
              <mxPoint x="290" y="1300"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Enter Manual -> Receive Manual (Cross swimlanes) -->
        <mxCell id="e_manual_receive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;" edge="1" source="act_enter_manual" target="act_receive_manual" parent="1">
          <mxGeometry relative="1" as="geometry"/>
