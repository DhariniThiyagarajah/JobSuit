          </mxGeometry>
        </mxCell>

        <!-- Branch B -> Merge Branches -->
        <mxCell id="e_branch_b_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="act_extract_details_b" target="merge_branches" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Branch C -> Merge Branches -->
        <mxCell id="e_branch_c_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" source="act_receive_manual" target="merge_branches" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
