        <!-- Confirm Job -> Save Job (Cross swimlanes) -->
        <mxCell id="e_confirm_save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=1.8;" edge="1" source="act_confirm_job" target="act_save_job" parent="1">
