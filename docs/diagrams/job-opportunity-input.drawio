        <!-- Save Job -> Success Message -->
        <mxCell id="e_save_msg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#334155;strokeWidth=1.5;" edge="1" source="act_save_job" target="act_success_msg" parent="1">
