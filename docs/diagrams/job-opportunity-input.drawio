        <mxCell id="e_inform_fallback" value="Offer Screenshot or Manual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.5;fontColor=#B45309;fontStyle=1;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" source="act_inform_inaccessible" target="merge_input_choice" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="375"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Decision: Branch C [Manual Entry] -->
        <mxCell id="e_dec_branch_c" value="[Manual Entry]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1D4ED8;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="dec_input_method" target="act_enter_manual" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
